# Discord app id. The default is the app this project was built around.
DISCORD_CLIENT_ID=1504152588684230656

# The script will not poll faster than 15 seconds.
POLL_SECONDS=15

# Button and hover text.
LISTEN_BUTTON_LABEL=Listen
ALBUM_BUTTON_LABEL=Album
DISCORD_SMALL_TEXT=Playing from Yandex Music

# clear hides the Discord card on pause. show keeps it visible.
PAUSE_BEHAVIOR=clear

# If a search result scores lower than this, the script skips its cover/buttons.
MIN_MATCH_SCORE=70

# Write played tracks to history.csv.
HISTORY_ENABLED=1

# Discord Developer Portal asset keys, if you use them.
DISCORD_SMALL_IMAGE=f
DISCORD_FALLBACK_LARGE_IMAGE=
