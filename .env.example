# Discord application id. Keep the default if you use the bundled app.
DISCORD_CLIENT_ID=1504152588684230656

# Minimum poll interval is 15 seconds to stay friendly to Discord RPC behavior.
POLL_SECONDS=15

# Rich Presence labels.
LISTEN_BUTTON_LABEL=Listen
ALBUM_BUTTON_LABEL=Album
DISCORD_SMALL_TEXT=Playing from Yandex Music

# show = keep the card and mark it as paused; clear = remove the card on pause.
PAUSE_BEHAVIOR=show

# Hide cover/buttons when the Yandex Music search match is too weak.
MIN_MATCH_SCORE=70

# Save played tracks to history.csv.
HISTORY_ENABLED=1

# Optional Discord Developer Portal asset keys.
DISCORD_SMALL_IMAGE=f
DISCORD_FALLBACK_LARGE_IMAGE=
